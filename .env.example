# Vercel / Neon Postgres 数据库连接字符串
# 通过 Vercel Dashboard 添加 Marketplace Neon 后自动注入，格式示例：
# postgresql://user:password@host:5432/db?sslmode=require
DATABASE_URL=

# 本地开发使用的分散数据库配置（当未配置 DATABASE_URL 时生效）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=meeting_db
DB_USER=postgres
DB_PASSWORD=your_password

# AI 服务（可选）
# 未配置时使用本地规则模拟；配置后调用 OpenAI Chat API
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
