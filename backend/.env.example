# 服务端口（仅本地开发使用）
PORT=3000

# PostgreSQL 数据库配置
# 方式一：Vercel / Neon 推荐使用 DATABASE_URL（推荐）
# DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require
# 请使用 Neon Pooled 连接串；不要加 channel_binding=require（Node pg 可能认证失败）

# 方式二：本地开发使用分散配置（当未配置 DATABASE_URL 时生效）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=meeting_db
DB_USER=postgres
DB_PASSWORD=your_password

# AI 服务（可选）
# 未配置时使用本地规则模拟；配置后调用 OpenAI Chat API
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
